# PostgreSQL接続URL（書き込み権限が必要）
# ローカル開発: postgresql://user@localhost:5432/dbname
# 本番: Railway等のホスティングDB
DATABASE_URL="postgresql://kouheikameyama@localhost:5432/auto_stock_trader"

# Slack Webhook URL（失敗 / 日次通知用、任意）
SLACK_WEBHOOK_URL=""

# Alpaca Paper Trading API（paper trading 実行時に必要）
ALPACA_API_KEY=""
ALPACA_API_SECRET=""
# REST エンドポイント（paper は paper-api、live は api）
ALPACA_API_ENDPOINT="https://paper-api.alpaca.markets/v2"
# マーケットデータ用エンドポイント（任意、デフォルト https://data.alpaca.markets）
ALPACA_DATA_ENDPOINT=""
